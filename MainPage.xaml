<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MyMauiApp.ViewModels"
             xmlns:models="clr-namespace:MyMauiApp.Models"
             x:Class="MyMauiApp.MainPage"
             Title="My Assets">

    <ContentPage.BindingContext>
        <viewmodels:MainViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout>
        <CollectionView ItemsSource="{Binding Assets}"
                        SelectionMode="None"
                        Margin="20"
                        VerticalOptions="FillAndExpand">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Asset">
                    <Grid Padding="10" ColumnDefinitions="Auto, *">
                        <Image Source="{Binding Icon}" 
                               WidthRequest="40" 
                               HeightRequest="40" 
                               VerticalOptions="Center" />
                        
                        <VerticalStackLayout Grid.Column="1" Margin="15,0,0,0" VerticalOptions="Center">
                            <Label Text="{Binding Name}" 
                                   FontAttributes="Bold" 
                                   FontSize="18" />
                            <Label Text="{Binding Description}" 
                                   TextColor="Gray" />
                            <Label Text="{Binding Value, StringFormat='{0:C}'}" 
                                   TextColor="Green" 
                                   FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="About Us"
                Clicked="OnAboutButtonClicked"
                Margin="20,0,20,10"
                HorizontalOptions="FillAndExpand" />

        <Button Text="Contact Us"
                Clicked="OnContactButtonClicked"
                Margin="20,0,20,20"
                HorizontalOptions="FillAndExpand" />
    </VerticalStackLayout>
</ContentPage>