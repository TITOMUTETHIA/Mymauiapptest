@page "/"
@attribute [AllowAnonymous]
@implements IDisposable
@inject MainViewModel ViewModel

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Asset Inventory</h2>
        <button class="btn btn-primary" @onclick="ViewModel.LoadAssetsAsync">
            <i class="oi oi-reload"></i> Refresh
        </button>
    </div>

    @if (ViewModel.Assets == null || !ViewModel.Assets.Any())
    {
        <div class="alert alert-info">
            No assets found. Click refresh or import a new model.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var asset in ViewModel.Assets)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">@asset.Name</h5>
                            <h6 class="card-subtitle mb-2 text-muted">@asset.Category</h6>
                            <p class="card-text">@asset.Description</p>
                            <p class="card-text"><strong>Value:</strong> @asset.Value.ToString("C")</p>

                            <AuthorizeView>
                                <Authorized>
                                    <div class="d-flex gap-2 mt-3">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewModel.AnalyzeAssetAsync(asset)">
                                            Analyze AI
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ViewModel.DeleteAssetAsync(asset)">
                                            Delete
                                        </button>
                                    </div>
                                </Authorized>
                            </AuthorizeView>

                            @if (!string.IsNullOrEmpty(asset.AiAnalysis))
                            {
                                <div class="mt-3 p-2 bg-light border rounded small">
                                    <strong>AI Insights:</strong><br />
                                    @asset.AiAnalysis
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        // Subscribe to state changes so the UI refreshes when AI analysis or deletions occur
        ViewModel.OnStateChanged += HandleStateChanged;
        await ViewModel.LoadAssetsAsync();
    }

    private void HandleStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        // Unsubscribe to prevent memory leaks
        ViewModel.OnStateChanged -= HandleStateChanged;
    }
}