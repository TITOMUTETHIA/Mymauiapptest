@using MyMauiApp.Shared
@inherits ErrorBoundary
@inject IToastService ToastService

@if (CurrentException == null)
{
    @ChildContent
}
else
{
    <div class="p-5 m-5 border border-danger rounded bg-light shadow-sm text-center">
        <div class="mb-3">
            <i class="oi oi-warning text-danger" style="font-size: 3rem;"></i>
        </div>
        <h3 class="text-danger">Something went wrong</h3>
        <p class="text-muted">
            The application encountered an unexpected error. 
            Our team has been notified.
        </p>
        <button class="btn btn-outline-primary mt-3" @onclick="HandleRecover">
            <i class="oi oi-reload"></i> Attempt Recovery
        </button>
    </div>
}

@code {
    protected override Task OnErrorAsync(Exception exception)
    {
        // Log the error and notify the user via your custom toast service
        ToastService.ShowToast($"Application Error: {exception.Message}");
        return Task.CompletedTask;
    }

    private void HandleRecover() => Recover();
}