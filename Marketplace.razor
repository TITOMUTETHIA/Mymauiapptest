@page "/marketplace"
@using MyMauiApp.Shared.Services
@inject MyMauiApp.Shared.Services.ICartService CartService

<div class="marketplace">
    <header class="hero">
        <div class="hero-content">
            <h1>CODE CHAMPS <span class="highlight">STUDIOS</span></h1>
            <p>Next-gen 3D assets for ambitious game developers.</p>
            <div class="search-bar">
                <input type="text" placeholder="Search assets (e.g. Low Poly, Rigged, Textures)..." />
                <button class="btn-primary">Search</button>
            </div>
        </div>
    </header>

    <section class="asset-grid">
        @foreach (var asset in FeaturedAssets)
        {
            <div class="asset-card">
                <div class="asset-preview">
                    <img src="@asset.ThumbnailUrl" alt="@asset.Name" />
                    <span class="category">@asset.Category</span>
                </div>
                <div class="asset-info">
                    <h3>@asset.Name</h3>
                    <p class="author">by @asset.Author</p>
                    <div class="price-row">
                        <span class="price">$@asset.Price</span>
                        <button class="btn-buy" @onclick="() => AddToCart(asset.Name)">Add to Cart</button>
                    </div>
                </div>
            </div>
        }
    </section>
</div>

@code {
    private async Task AddToCart(string name)
    {
        await CartService.AddToCartAsync(name);
    }

    private List<AssetItem> FeaturedAssets = new()
    {
        new AssetItem { Name = "Cyberpunk Street Kit", Category = "Environment", Price = 45.00m, Author = "NeonArchitect", ThumbnailUrl = "https://via.placeholder.com/300x200?text=Cyberpunk+Kit" },
        new AssetItem { Name = "Stylized Knight Rigged", Category = "Characters", Price = 29.99m, Author = "Champs3D", ThumbnailUrl = "https://via.placeholder.com/300x200?text=Knight+Model" },
        new AssetItem { Name = "Ultimate Sci-Fi Weapon Pack", Category = "Props", Price = 15.50m, Author = "ArsenalZero", ThumbnailUrl = "https://via.placeholder.com/300x200?text=Weapons+Pack" },
        new AssetItem { Name = "Modular Dungeon Master", Category = "Environment", Price = 59.00m, Author = "DungeonCrafter", ThumbnailUrl = "https://via.placeholder.com/300x200?text=Dungeon+Kit" }
    };

    public class AssetItem
    {
        public string Name { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public decimal Price { get; set; }
        public string Author { get; set; } = string.Empty;
        public string ThumbnailUrl { get; set; } = string.Empty;
    }
}