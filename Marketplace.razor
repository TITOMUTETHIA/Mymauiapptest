@page "/marketplace"
@using MyMauiApp.Shared.Services
@using MyMauiApp.Shared.Models
@inject MyMauiApp.Shared.Services.ICartService CartService

<div class="marketplace">
    <header class="hero">
        <div class="hero-content">
            <h1>CODE CHAMPS <span class="highlight">STUDIOS</span></h1>
            <p>Next-gen 3D assets for ambitious game developers.</p>
            <div class="search-bar">
                <input type="text" placeholder="Search assets (e.g. Low Poly, Rigged, Textures)..." />
                <button class="btn-primary">Search</button>
            </div>
        </div>
    </header>

    <section class="asset-grid">
        @foreach (var asset in FeaturedAssets)
        {
            <div class="asset-card">
                <div class="asset-preview">
                    <img src="@asset.ThumbnailUrl" alt="@asset.Name" />
                    <span class="category">@asset.Category</span>
                </div>
                <div class="asset-info">
                    <h3>@asset.Name</h3>
                    <p class="author">by @asset.Author</p>
                    <div class="price-row">
                        <span class="price">$@asset.Price</span>
                        <button class="btn-preview" @onclick="() => PreviewModel(asset)">View 3D</button>
                        <button class="btn-buy" @onclick="() => AddToCart(asset)">Add to Cart</button>
                    </div>
                </div>
            </div>
        }
    </section>

    @if (selectedAssetForPreview != null)
    {
        <div class="modal-overlay" @onclick="ClosePreview">
            <div class="modal-content" @onclick:stopPropagation="true">
                <button class="close-btn" @onclick="ClosePreview">&times;</button>
                <model-viewer src="@selectedAssetForPreview.ModelUrl"
                              alt="A 3D model of @selectedAssetForPreview.Name"
                              auto-rotate camera-controls
                              shadow-intensity="1"
                              ar>
                    <div slot="poster" class="loading-overlay">
                        <img src="@selectedAssetForPreview.ThumbnailUrl" class="poster-img" />
                        <div class="spinner"></div>
                    </div>
                </model-viewer>
                <div class="modal-footer">
                    <h3>@selectedAssetForPreview.Name</h3>
                    <button class="btn-buy" @onclick="() => AddToCart(selectedAssetForPreview)">Add to Cart $@selectedAssetForPreview.Price</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private Asset? selectedAssetForPreview;

    private async Task AddToCart(Asset asset)
    {
        await CartService.AddToCartAsync(asset);
    }

    private void PreviewModel(Asset asset) => selectedAssetForPreview = asset;
    private void ClosePreview() => selectedAssetForPreview = null;

    private List<Asset> FeaturedAssets = new()
    {
        new Asset { Name = "Cyberpunk Street Kit", Category = "Environment", Price = 45.00m, Author = "NeonArchitect", ThumbnailUrl = "https://via.placeholder.com/300x200?text=Cyberpunk+Kit", ModelUrl="https://modelviewer.dev/shared-assets/models/Astronaut.glb" },
        new Asset { Name = "Stylized Knight Rigged", Category = "Characters", Price = 29.99m, Author = "Champs3D", ThumbnailUrl = "https://via.placeholder.com/300x200?text=Knight+Model", ModelUrl="https://modelviewer.dev/shared-assets/models/RobotExpressive.glb" },
        new Asset { Name = "Ultimate Sci-Fi Weapon Pack", Category = "Props", Price = 15.50m, Author = "ArsenalZero", ThumbnailUrl = "https://via.placeholder.com/300x200?text=Weapons+Pack", ModelUrl="https://modelviewer.dev/shared-assets/models/Astronaut.glb" },
        new Asset { Name = "Modular Dungeon Master", Category = "Environment", Price = 59.00m, Author = "DungeonCrafter", ThumbnailUrl = "https://via.placeholder.com/300x200?text=Dungeon+Kit", ModelUrl="https://modelviewer.dev/shared-assets/models/RobotExpressive.glb" }
    };
}