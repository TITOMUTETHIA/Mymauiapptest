<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyMauiApp.AboutPage"
             Title="About Us">
    <ScrollView>
        <VerticalStackLayout Spacing="10" Padding="20">
            <Label Text="About MyMauiApp"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />
            <Label Text="Welcome to MyMauiApp, your go-to application for tracking your digital assets."
                   FontSize="16"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />
            <Label Text="Our mission is to provide a simple, intuitive, and powerful tool for managing your cryptocurrency portfolio."
                   FontSize="16"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />
            <Label Text="Version: 1.0.0"
                   FontSize="14"
                   TextColor="Gray"
                   HorizontalOptions="Center" />
            <Label Text="Developed by BIGFISH"
                   FontSize="14"
                   TextColor="Gray"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>