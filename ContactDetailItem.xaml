<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyMauiApp.ContactDetailItem">
    <VerticalStackLayout>
        <Label Text="{Binding DetailTitle}" 
               Style="{DynamicResource ContactDetailTitleStyle}" />
        <Label Text="{Binding DetailValue}" 
               Style="{DynamicResource ContactDetailValueStyle}" />
    </VerticalStackLayout>
</ContentView>