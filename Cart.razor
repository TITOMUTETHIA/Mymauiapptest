@page "/cart"
@namespace MyMauiApp.Shared.Components
@using MyMauiApp.Shared.Services
@using System.Linq
@inject ICartService CartService
@implements IDisposable

<div class="cart-page">
    <div class="container">
        <h1>Your <span class="highlight">Cart</span></h1>
        <p>Review your assets before proceeding to checkout.</p>

        @if (!CartService.Items.Any())
        {
            <div class="empty-state">
                <p>Your cart is empty. Ready to build something great?</p>
                <a href="/marketplace" class="btn-primary">Browse Marketplace</a>
            </div>
        }
        else
        {
            <div class="cart-list">
                @foreach (var item in CartService.Items)
                {
                    <div class="cart-item">
                        <span class="item-name">@item</span>
                        <button class="btn-remove" @onclick="() => RemoveFromCart(item)">Remove</button>
                    </div>
                }
            </div>

            <div class="cart-summary">
                <p>Total Items: <strong>@CartService.GetCount()</strong></p>
                <button class="btn-checkout">Secure Checkout</button>
            </div>
        }
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        CartService.OnChange += StateHasChanged;
    }

    private async Task RemoveFromCart(string name)
    {
        await CartService.RemoveFromCartAsync(name);
    }

    public void Dispose() => CartService.OnChange -= StateHasChanged;
}