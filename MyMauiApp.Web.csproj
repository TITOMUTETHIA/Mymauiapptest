<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.6.0" />
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude MAUI-specific files from the Web build to avoid compilation errors -->
    <Compile Remove="Platforms\**" />
    <Compile Remove="Resources\**" />
    <Compile Remove="MauiProgram.cs" />
    <Compile Remove="MauiCameraService.cs" />
    <Compile Remove="MauiToastService.cs" />
    <Compile Remove="ModelImportService.cs" />
    <Compile Remove="SqliteAssetService.cs" />
    <Compile Remove="MainPage.xaml.cs" />
    <Compile Remove="App.xaml.cs" />
    <Compile Remove="AppShell.xaml.cs" />
    <Compile Remove="AboutPage.xaml.cs" />
    <Compile Remove="ContactPage.xaml.cs" />
    <!-- Exclude XAML files which are not supported in Blazor WebAssembly projects -->
    <None Remove="**\*.xaml" />
  </ItemGroup>

</Project>