<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Exclude MAUI-specific files to prevent compilation conflicts -->
    <DefaultItemExcludes>$(DefaultItemExcludes);MauiProgram.cs;MauiCameraService.cs;App.xaml*;MainPage.xaml*;ContactPage.xaml*</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0-preview.1.25122.6" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0-preview.1.25122.6" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="MyMauiApp.Shared.csproj" />
  </ItemGroup>
</Project>